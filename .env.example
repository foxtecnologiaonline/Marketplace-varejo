# Banco de dados (Supabase) — pedidos, pagamentos e catálogo. Chave de SERVIÇO,
# nunca exposta ao navegador (usada só em código server-only).
# Sem essas duas variáveis, o checkout funciona mas NÃO persiste pedidos nem
# decrementa estoque (fica em memória, só para a sessão da requisição).
# Ver docs/ESCOPO-FASE2.md §5 e supabase/migrations/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (login por link mágico em /conta) — chave ANÔNIMA/pública, para uso
# no navegador. Mesmo projeto do SUPABASE_URL acima; a URL é a mesma, só repetida
# com o prefixo NEXT_PUBLIC_ porque só variáveis com esse prefixo chegam ao
# navegador. Sem isso, /conta mostra o aviso "em breve" em vez do formulário de
# login — nunca testado contra um projeto Supabase real nesta revisão.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago (Checkout Pro — Pix + cartão).
# Sem isso, o checkout cria o pedido como "pendente" e pula direto para a
# página de sucesso, sem cobrar pagamento de verdade. Pegue o token em
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=

# Secret do webhook (painel do Mercado Pago > Webhooks > detalhes da assinatura).
# Sem ele, o webhook aceita notificações sem verificar a assinatura (um aviso aparece
# uma vez no log) — nunca falha, mas também não garante que a notificação veio
# mesmo do Mercado Pago. Configure antes de ir para produção.
MERCADOPAGO_WEBHOOK_SECRET=

# Assina o link da página de sucesso do pedido (/checkout/sucesso?pedido=...&t=...),
# pra ninguém ver os dados de um pedido alheio só por ter o UUID. Sem configurar,
# usa um segredo aleatório gerado no processo (funciona, mas muda a cada reinício —
# links antigos param de abrir). Configure antes de produção.
ORDER_TOKEN_SECRET=

# E-mail transacional (Resend) para confirmação de pedido e para notificar o
# time comercial sobre pedidos de cotação institucional (/cotacao).
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@seudominio.com.br
SALES_NOTIFICATION_EMAIL=comercial@seudominio.com.br

# URL pública do site, usada nas back_urls do Mercado Pago e no webhook.
# Só é exigida quando MERCADOPAGO_ACCESS_TOKEN está configurado: em produção,
# o checkout recusa o pagamento sem ela (para não montar as URLs de retorno a
# partir do header Host, que pode ser forjado). Sem Mercado Pago configurado,
# não é usada. Em dev, pode deixar vazio: é inferido do host da requisição.
NEXT_PUBLIC_SITE_URL=

# Botão flutuante de WhatsApp (só dígitos, com DDI+DDD, ex.: 5534999999999).
# Sem ele o botão não aparece. É lido no build: defina antes de `npm run build`.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Redes sociais no rodapé. Cada ícone só aparece se a URL real existir — nunca
# linkamos um "#" morto. Lidas no build: defina antes de `npm run build`.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
