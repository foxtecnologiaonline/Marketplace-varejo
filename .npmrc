# npm 10.9.4 trava com "Cannot read properties of null (reading 'edgesOut')" ao
# resolver o grafo de peerDependencies opcionais do Vitest 4 (@vitest/browser-playwright
# -> canvas). legacy-peer-deps evita o bug do arborist; sem isso `npm install` falha
# tanto localmente quanto no CI.
legacy-peer-deps=true
